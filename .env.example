# Required: Cohere API key for answer generation
COHERE_API_KEY=your_cohere_api_key_here

# Optional: Qdrant Cloud URL (leave empty for in-memory mode)
# Get a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Required for figure image storage (get from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
